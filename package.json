{
  "name": "slow-your-roll",
  "version": "1.0.0",
  "description": "Bonus-roll expected-value tracker for WoW Midnight (buildless static site)",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup.js --test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "data": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check",
    "dev": "node scripts/serve.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2"
  }
}
