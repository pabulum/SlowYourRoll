{
  "name": "slow-your-roll",
  "version": "1.0.0",
  "description": "Bonus-roll expected-value tracker for WoW Midnight (buildless static site)",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup.js --test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "data": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^7.0.2"
  }
}
