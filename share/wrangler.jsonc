// The share Worker: share links unfurl as the board (share/card.js, src/share.js).
// Deploy from the repo root with `npx wrangler deploy -c share/wrangler.jsonc`.
{
  "name": "slowyourroll",
  // The account the Worker lives in, so a login that can see several accounts doesn't stop to ask.
  "account_id": "b2fe2d2ba8569a7414583b882e37bdfd",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // Short links' words and the long links behind them (share/schema.sql). D1 rather than KV
  // because a link is read from wherever Discord's crawler is, seconds after it was written from
  // wherever the sharer is, and KV can take a minute to show a new key to another location.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slowyourroll",
      "database_id": "c6946457-dc83-41ae-b83b-4885e99853a4"
    }
  ]
}
